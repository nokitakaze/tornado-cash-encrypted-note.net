<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <PackageVersion>0.2.1</PackageVersion>
        <Authors>NokitaKaze</Authors>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/nokitakaze/tornado-cash-encrypted-note.net</RepositoryUrl>
        <PackageTags>ethereum tornadocash</PackageTags>
        <AssemblyName>NokitaKaze.TornadoCashEncryptedNote</AssemblyName>
        <RootNamespace>NokitaKaze.TornadoCashEncryptedNote</RootNamespace>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <DocumentationFile>bin\Release\TornadoCashEncryptedNote.xml</DocumentationFile>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Keccak256" Version="1.0.2" />
      <PackageReference Include="NaCl.Net" Version="0.1.13" />
    </ItemGroup>

</Project>
